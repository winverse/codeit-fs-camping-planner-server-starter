{
  "name": "camping-planner-server",
  "version": "1.0.0",
  "description": "",
  "main": "./src/main.js",
  "type": "module",
  "imports": {
    "#config": "./src/config/config.js",
    "#prisma/*": "./src/prisma/*",
    "#repositories": "./src/repositories/index.js",
    "#constants": "./src/common/constants/index.js",
    "#exceptions": "./src/common/exceptions/index.js",
    "#schemas": "./src/common/schemas/index.js",
    "#mappers": "./src/common/mappers/index.js",
    "#controllers": "./src/controllers/index.js",
    "#services": "./src/services/index.js",
    "#middlewares": "./src/middlewares/index.js",
    "#providers": "./src/providers/index.js"
  },
  "scripts": {
    "dev": "nodemon --env-file=./env/.env.development ./src/main.js",
    "start": "node --env-file=./env/.env.development src/main.js",
    "prisma:emit": "dotenv -e ./env/.env.development -- prisma contract emit",
    "prisma:init": "dotenv -e ./env/.env.development -- prisma db init",
    "campsites:sync": "node --env-file=./env/.env.development src/scripts/sync-campsites.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.3.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.20",
    "awilix": "^13.0.5",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "dotenv-cli": "^11.1.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "prisma": "8.0.0-rc.27"
  }
}
