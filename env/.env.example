# 환경 설정
NODE_ENV=development

# 서버 포트. 화면 프로젝트 .env.local의 NEXT_PUBLIC_API_URL(http://localhost:4000)과 맞춥니다.
PORT=4000

# PostgreSQL 연결 URL
DATABASE_URL="postgresql://<사용자>:<비밀번호>@localhost:5432/camping_planner"

# 공공데이터포털에서 발급받은 고캠핑 API 일반 인증키
GOCAMPING_SERVICE_KEY="<일반 인증키>"

# 쉼표로 구분한 운영 환경 허용 출처. 개발 환경에서는 비워 둘 수 있습니다.
# 예: CORS_ORIGINS=https://example.com,https://admin.example.com (주소 끝에 /를 붙이지 않음)
CORS_ORIGINS=
